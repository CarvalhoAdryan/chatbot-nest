# Simulação local: não envia mensagens reais nem registra denúncias.
# true: console + fotos fictícias + backend simulado; false: integrações reais.
SIMULATION_MODE=true
# Porta HTTP do NestJS. Se mudar, ajuste WEBHOOK_URL no simulador.
PORT=3001
# Segredo compartilhado com o cabeçalho x-webhook-token. Troque o exemplo para uso real.
WEBHOOK_TOKEN=dev-change-me
# Opcional na simulação; obrigatório no modo real.
# Exemplo local: redis://localhost:6379. Vazio só é permitido na simulação.
REDIS_URL=
# Modo real: SIMULATION_MODE=false e todas as variáveis abaixo preenchidas.
# URL base HTTP(S) do servidor Evolution, sem o caminho de envio.
EVOLUTION_URL=
# Nome da instância Evolution atendida por esta implantação.
EVOLUTION_INSTANCE=
# Credencial de servidor enviada à Evolution no cabeçalho apikey.
EVOLUTION_APIKEY=
# URL base da API que oferece POST /bot/complaints.
BACKEND_URL=
# Credencial de servidor enviada à API de denúncias em x-bot-key.
BOT_API_KEY=
# URL HTTP(S) do projeto Supabase que armazena as imagens.
SUPABASE_URL=
# Chave privilegiada do servidor; nunca inclua um valor real no Git.
SUPABASE_SERVICE_ROLE_KEY=
# Bucket de imagens. O contrato atual retorna URLs de leitura pública.
SUPABASE_BUCKET=

# Somente no simulador; descomente para mudar o destino ou número fictício.
# WEBHOOK_URL=http://localhost:3001/webhook
# SIM_NUMBER=5599999999999
# NODE_ENV=production proíbe SIMULATION_MODE=true.
